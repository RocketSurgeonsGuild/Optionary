<Project Sdk="Microsoft.NET.Sdk">
  <!--
      Dovetail's JSON configuration joints, as templates. It doesn't depend on Optionary (decision D12). build/*.cs.template are
      Dovetail joint templates, declared by build/Optionary.Configuration.Json.targets and packed as they are; they are not compiled
      here.

      The assembly has no types. It is shipped anyway because Dovetail emits a DovetailTemplate whose Package is set only into
      projects that resolve an assembly named after that package.
  -->
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <PackageDescription>Three Dovetail joint templates (JsonJoint, JsonBrowserJoint and JsonEmbeddedJoint) that add an application's JSON configuration files with Microsoft.Extensions.Configuration.Json. They target Dovetail's joint API and do nothing without Dovetail.</PackageDescription>
    <PackageTags>$(PackageTags);configuration;json</PackageTags>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <RootNamespace>Optionary.Configuration.Json</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
  </ItemGroup>
  <ItemGroup>
    <None Include="build/*.*" Pack="true" PackagePath="build" />
    <None Include="buildMultiTargeting/*.*" Pack="true" PackagePath="buildMultiTargeting" />
    <None Include="buildTransitive/*.*" Pack="true" PackagePath="buildTransitive" />
  </ItemGroup>
</Project>
