<Project>
  <!--
      Optionary's compiler-visible properties. Imported by package consumers (build/, buildTransitive/ and buildMultiTargeting/)
      and by this repository's own projects (src/Directory.Build.props).
  -->
  <ItemGroup>
    <!-- The registration method is emitted in the project's RootNamespace (the global namespace when that is empty). -->
    <CompilerVisibleProperty Include="RootNamespace" />
    <!-- OptionaryZeroAllocValidation=false leaves ZeroAlloc.Validation's registrations to the project. -->
    <CompilerVisibleProperty Include="OptionaryZeroAllocValidation" />
  </ItemGroup>
</Project>
