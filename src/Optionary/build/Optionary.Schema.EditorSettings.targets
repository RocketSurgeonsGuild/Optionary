<Project>
  <!--
    Opt-in VS Code settings for a host's configuration schema, imported by Optionary.Schema.targets.

    With OptionaryScaffoldEditorSettings=true, building a host creates or updates only Optionary's own mappings in
    .vscode/settings.json: json.schemas (appsettings*.json), yaml.schemas (appsettings*.yaml and .yml) and
    evenBetterToml.schema.associations (appsettings*.toml), each pointing at the host's $(BaseIntermediateOutputPath)appsettings.schema.json.
    Every host gets entries of its own (they are keyed by its schema path), so several hosts can share one file. Everything else
    in the file stays as it is, comments included, and nothing is written when the mappings are already there. A file Optionary
    can't update safely (invalid JSON, an unexpected shape, read-only) is left alone and the build warns with the entries to paste.
    Optionary never adds $schema keys or modelines to the configuration files.

    Properties:
      OptionaryScaffoldEditorSettings=true     turns this on; it is off by default because the file is probably checked in.
      OptionaryEditorSettingsDirectory=<path>  the folder that holds .vscode (relative paths are relative to the project). By
                                              default the nearest ancestor of the project that contains a .git entry, or the
                                              project directory itself when there is none.

    Only hosts (see Optionary.Schema.targets) and only once per build: a project that targets several frameworks does
    it from its first one. Design-time builds and OptionarySchema=false skip it.
  -->
  <!-- In-repo builds register this from src/Optionary.Build.Tasks instead (Optionary.Build.Tasks.InRepo.targets). -->
  <UsingTask TaskName="Optionary.Build.Tasks.ScaffoldEditorSettings" AssemblyFile="$(MSBuildThisFileDirectory)tasks/netstandard2.0/Optionary.Build.Tasks.dll" Condition="'$(_OptionaryBuildTasksAssembly)' == ''" />

  <Target
    Name="_OptionaryScaffoldEditorSettings"
    AfterTargets="_OptionarySchema"
    DependsOnTargets="_OptionaryComputeSchema"
    Condition="'$(OptionaryScaffoldEditorSettings)' == 'true' and '$(DesignTimeBuild)' != 'true' and '$(BuildingProject)' == 'true'">
    <PropertyGroup>
      <_OptionaryEditorSettingsDirectory />
      <_OptionaryEditorSettingsDirectory Condition="'$(OptionaryEditorSettingsDirectory)' != ''">$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(OptionaryEditorSettingsDirectory)'))</_OptionaryEditorSettingsDirectory>
    </PropertyGroup>
    <ScaffoldEditorSettings
      Condition="'$(_OptionarySchemaRole)' == 'Host' and '$(_OptionarySchemaIsPrimaryTargetFramework)' == 'true'"
      ProjectDirectory="$(MSBuildProjectDirectory)"
      SchemaFile="$(_OptionaryHostSchemaFile)"
      SettingsDirectory="$(_OptionaryEditorSettingsDirectory)" />
  </Target>
</Project>
