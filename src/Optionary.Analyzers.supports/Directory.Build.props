<Project>
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
    <PropertyGroup>
        <_Analyzer_Roslyn_Version_>$(MSBuildProjectName.Replace('Optionary.Analyzers.', ''))</_Analyzer_Roslyn_Version_>
        <DefineConstants>$(DefineConstants);$(_Analyzer_Roslyn_Version_.Replace('.', '_').ToUpper())</DefineConstants>
        <BaseOutputPath>bin/$(_Analyzer_Roslyn_Version_)/</BaseOutputPath>
        <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)obj/$(_Analyzer_Roslyn_Version_)/</BaseIntermediateOutputPath>
        <NoWarn>NU5105;$(NoWarn)</NoWarn>
        <RootNamespace>Optionary.Analyzers</RootNamespace>
        <AssemblyName>Optionary.Analyzers</AssemblyName>
        <IsPackable>false</IsPackable>
        <NoPackageAnalysis>true</NoPackageAnalysis>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <TargetFramework>netstandard2.0</TargetFramework>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <GenerateAssemblyInfoManifest>false</GenerateAssemblyInfoManifest>
        <!-- The generator only reads its own constants; the dependency accessors load assemblies, which analyzers may not. -->
        <AssemblyInfoDependencies>false</AssemblyInfoDependencies>
        <!-- The namespace the Optionary.Analyzers project generates AssemblyInfo in, for the shared sources. -->
        <AssemblyInfoNamespace>Optionary.Analyzers</AssemblyInfoNamespace>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <!--
            These builds compile Optionary.Analyzers' own sources against older Roslyn versions, and Optionary.Analyzers runs the
            analyzers over the same files. Running them here again costs about half of each compile and produces the same assembly.
        -->
        <RunAnalyzers>false</RunAnalyzers>
    </PropertyGroup>
</Project>
