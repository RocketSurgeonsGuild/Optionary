<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <!-- The package under test (PackageUnderTest.targets). -->
        <PackageUnderTestProject>$(MSBuildThisFileDirectory)../../src/Optionary.Configuration.Yaml/Optionary.Configuration.Yaml.csproj</PackageUnderTestProject>
        <PackageUnderTestDirectory>$(MSBuildProjectDirectory)/$(BaseIntermediateOutputPath)yaml-package/</PackageUnderTestDirectory>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\src\Optionary.Configuration.Yaml\Optionary.Configuration.Yaml.csproj" />
    </ItemGroup>

    <!-- The package tests (PackageContentTests, WithoutDovetailTests) read the Optionary.Configuration.Yaml package as it ships. -->
    <Import Project="$(MSBuildThisFileDirectory)../PackageUnderTest.targets" />
</Project>
