<Project>
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
    <Import Project="$(MSBuildThisFileDirectory)../src/Optionary/build/Optionary.props" />
    <PropertyGroup>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <OutputType>Exe</OutputType>
        <IsTestProject>true</IsTestProject>
        <!--
            The repo-wide LatestMajor would run the net10.0 tests on the newest installed runtime (.NET 11), so a .NET 10 regression
            would pass CI. Keep each target on its own major: mise installs the .NET 10 runtime alongside the SDK for this.
        -->
        <RollForward>Minor</RollForward>
    </PropertyGroup>
    <PropertyGroup Condition="$(MSBuildProjectName.StartsWith('Optionary.Analyzers.'))">
        <!--
            The generator tests reference Optionary.dll and run the generator as a library, not as an analyzer, which is what
            _OptionaryCheckGenerator (OPT1001) would otherwise report.
        -->
        <_OptionarySkipGeneratorCheck>true</_OptionarySkipGeneratorCheck>
    </PropertyGroup>
</Project>
