<Project>
    <ItemGroup>
        <!-- AssemblyInfo.Dependencies gives the generator's versions to the shared snapshot scrubbers without reflection. -->
        <PackageReference Include="Rocket.Surgery.AssemblyInfo" PrivateAssets="all" />
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
        <PackageReference Include="Rocket.Surgery.Extensions.Testing.SourceGenerators" />
        <PackageReference Include="Verify.SourceGenerators" />
        <ProjectReference Include="..\..\src\Optionary\Optionary.csproj" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="5.12.0" PrivateAssets="all" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" VersionOverride="5.12.0" PrivateAssets="all" />
        <PackageReference Include="Microsoft.CodeAnalysis.Common" VersionOverride="5.12.0" PrivateAssets="all" />
        <PackageReference Include="Microsoft.CodeAnalysis.Features" VersionOverride="5.12.0" PrivateAssets="all" />
        <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" VersionOverride="5.12.0" PrivateAssets="all" />
    </ItemGroup>
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildThisFileDirectory)../'))" />
</Project>
