{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Generated by Optionary from the configuration sections this project and its references declare; the build overwrites it. definitions/SchemaStoreAppSettings is SchemaStore's appsettings.json schema (https://json.schemastore.org/appsettings.json, Apache License 2.0), with its $schema, $id and title removed and its local $refs rewritten to point into that definition.",
  "definitions": {
    "SchemaStoreAppSettings": "{SchemaStore's appsettings schema}",
    "App": {
      "type": "object",
      "title": "App",
      "properties": {
        "Name": {
          "type": "string"
        }
      },
      "patternProperties": {
        "^(?:[Nn][Aa][Mm][Ee])$": {
          "type": "string"
        }
      },
      "propertyNames": {
        "pattern": "^(?:[Nn][Aa][Mm][Ee])$",
        "patternErrorMessage": "Unknown key in section \"App\". Known keys (case-insensitive): Name.",
        "doNotSuggest": true
      }
    },
    "HttpClients": {
      "type": "object",
      "properties": {
        "Petstore": {
          "$ref": "#/definitions/HttpClients:Petstore"
        }
      },
      "patternProperties": {
        "^(?:[Pp][Ee][Tt][Ss][Tt][Oo][Rr][Ee])$": {
          "$ref": "#/definitions/HttpClients:Petstore"
        }
      }
    },
    "HttpClients.Petstore.Retry": {
      "properties": {
        "Count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "propertyNames": {
        "pattern": "^(?:[Cc][Oo][Uu][Nn][Tt])$",
        "patternErrorMessage": "Unknown key in \"Retry\" (section \"HttpClients:Petstore\"). Known keys (case-insensitive): Count.",
        "doNotSuggest": true
      }
    },
    "HttpClients:Petstore": {
      "type": "object",
      "title": "HttpClients:Petstore",
      "description": "Petstore client; 100% \"generated\" for $(Configuration), @(Compile) and %(Identity) at user@example.com, naïve 'quotes' \\ and %3B.\nSecond line.",
      "properties": {
        "BaseAddress": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://\\S+$"
        },
        "Retry": {
          "type": "object",
          "allOf": [
            {
              "$ref": "#/definitions/HttpClients.Petstore.Retry"
            }
          ]
        }
      },
      "propertyNames": {
        "pattern": "^(?:[Bb][Aa][Ss][Ee][Aa][Dd][Dd][Rr][Ee][Ss][Ss]|[Rr][Ee][Tt][Rr][Yy])$",
        "patternErrorMessage": "Unknown key in section \"HttpClients:Petstore\". Known keys (case-insensitive): BaseAddress, Retry.",
        "doNotSuggest": true
      }
    }
  },
  "allOf": [
    {
      "$ref": "#/definitions/SchemaStoreAppSettings"
    },
    {
      "type": "object",
      "properties": {
        "App": {
          "$ref": "#/definitions/App"
        },
        "HttpClients": {
          "$ref": "#/definitions/HttpClients"
        }
      },
      "patternProperties": {
        "^(?:[Aa][Pp][Pp])$": {
          "$ref": "#/definitions/App"
        },
        "^(?:[Hh][Tt][Tt][Pp][Cc][Ll][Ii][Ee][Nn][Tt][Ss])$": {
          "$ref": "#/definitions/HttpClients"
        }
      }
    }
  ]
}