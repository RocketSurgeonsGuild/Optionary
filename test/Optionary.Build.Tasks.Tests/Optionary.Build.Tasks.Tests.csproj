<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\src\Optionary.Build.Tasks\Optionary.Build.Tasks.csproj" />
        <PackageReference Include="Corvus.Json.JsonSchema.Draft7" />
    </ItemGroup>
    <ItemGroup>
        <!-- Copies of the generator's snapshots in Optionary.Analyzers.Tests (see GeneratorOutputTests). -->
        <None Include="generator-output/*.txt" CopyToOutputDirectory="PreserveNewest" LinkBase="generator-output" />
