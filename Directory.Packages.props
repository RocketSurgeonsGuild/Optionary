<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Public API tracking: each packable project lists its public surface in PublicAPI.Shipped.txt / PublicAPI.Unshipped.txt (RS0016/RS0017 are errors). -->
    <GlobalPackageReference Include="Microsoft.DotNet.ApiCompat.Task" Version="11.0.100" />
    <GlobalPackageReference Include="ZeroAlloc.Analyzers" Version="1.13.1" />
    <GlobalPackageReference Include="Spectre.Console.Analyzer" Version="1.0.0" />
    <GlobalPackageReference Include="JetBrains.ExternalAnnotations" Version="10.2.172" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="Rocket.Surgery.AssemblyInfo" Version="2026.11.2" />
    <PackageVersion Include="Polyfill" Version="11.4.5" />
    <!-- The generator (src/Optionary.Analyzers); the roslyn5.x slices override this version. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
    <!-- Test-only: the source-generator test helpers bring the Workspaces/Features stack; keep it on the generator's Roslyn. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Common" Version="5.12.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.12.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Features" Version="5.12.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="5.12.0" />
    <!-- The MSBuild tasks (src/Optionary.Build.Tasks) compile against these; MSBuild.ProjectCreation brings Microsoft.Build in the build tests. Keep all three on one version. -->
    <PackageVersion Include="Microsoft.Build" Version="18.12.2" />
    <PackageVersion Include="Microsoft.Build.Framework" Version="18.12.2" />
    <PackageVersion Include="Microsoft.Build.Utilities.Core" Version="18.12.2" />
    <PackageVersion Include="MSBuild.ProjectCreation" Version="20.0.0" />
    <!-- Reads the binary logs of the scaffolded builds in Optionary.Build.Tests. -->
    <PackageVersion Include="MSBuild.StructuredLogger.Utils" Version="2.3.269" />
    <!-- Validates the merged schemas against the draft-07 meta-schema in the tasks' tests (Apache-2.0). -->
    <PackageVersion Include="Corvus.Json.JsonSchema.Draft7" Version="5.8.11" />
    <PackageVersion Include="ZeroAlloc.Validation" Version="2.6.1" />
    <PackageVersion Include="ZeroAlloc.Validation.Options" Version="2.6.1" />
    <PackageVersion Include="Bogus" Version="35.6.5" />
    <PackageVersion Include="Rocket.Surgery.Extensions.Testing.TUnit" Version="11.0.1" />
    <PackageVersion Include="Rocket.Surgery.Extensions.Testing.SourceGenerators" Version="11.0.1" />
    <PackageVersion Include="TUnit" Version="1.87.0" />
    <PackageVersion Include="TUnit.Mocks" Version="1.87.0" />
    <PackageVersion Include="TUnit.Assertions.Should" Version="1.85.0-beta" />
    <PackageVersion Include="Verify.TUnit" Version="33.7.0" />
    <PackageVersion Include="Verify.SourceGenerators" Version="2.5.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CrashDump" Version="2.5.3" />
    <PackageVersion Include="Microsoft.Testing.Extensions.HangDump" Version="2.5.3" />
    <!-- The CI pipeline (build/Build.cs, a file-based app). Build tooling only: the libraries don't depend on any of these. -->
    <PackageVersion Include="Microsoft.VisualStudio.SolutionPersistence" Version="1.0.52" />
    <PackageVersion Include="Sourcy.DotNet" Version="1.1.1" />
    <PackageVersion Include="Sourcy.Git" Version="1.1.1" />
    <PackageVersion Include="Rocket.Surgery.ModularPipelines.Extensions" Version="0.2.4" />
    <PackageVersion Include="Joinery.Dovetail.ModularPipelines" Version="0.7.1" />
    <PackageVersion Include="ModularPipelines" Version="4.0.0" />
    <PackageVersion Include="Specular" Version="0.4.1" />
  </ItemGroup>
  <!--
      The pinned MSBuild task references sit in their own file so Renovate can leave just that group alone
      (.github/renovate.json) while the same packages elsewhere keep updating.
  -->
  <Import Project="$(MSBuildThisFileDirectory)Directory.Packages.MSBuildTasks.props" />
  <ItemGroup Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net11.0'))">
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net11.0'))">
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="11.0.0" />
  </ItemGroup>
</Project>
